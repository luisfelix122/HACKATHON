{
  "mcpServers": {
    "engram": {
      "command": "node",
      "args": ["scripts/engram.mjs", "mcp"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.10.1"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.3.0"]
    },
    "supabase-local": {
      "type": "http",
      "url": "http://localhost:55321/mcp"
    }
  }
}
