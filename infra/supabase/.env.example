# Nombres propios de Ayllu; completar en el .env oficial del servidor.
# Los secretos base los generan los scripts oficiales, no este archivo.
SUPABASE_PUBLIC_URL=
API_EXTERNAL_URL=
SITE_URL=
ADDITIONAL_REDIRECT_URLS=
GOOGLE_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
ENABLE_EMAIL_SIGNUP=
ENABLE_EMAIL_AUTOCONFIRM=
DISABLE_SIGNUP=
POOLER_TENANT_ID=

# Proxy interno; IA_API_KEY coincide con LITELLM_MASTER_KEY. Solo backend.
IA_BASE_URL=http://litellm:4000
IA_API_KEY=
IA_TIMEOUT_MS=8000
